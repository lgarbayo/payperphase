# PayPerPhase environment. Copy to .env (git-ignored). Every secret is optional:
# when one is missing the matching integration runs in MOCK mode and the UI shows a "Mock" badge.

# ---- App ----
PUBLIC_BASE_URL=http://localhost:3000
# JSON store location (db.json lives here). Render: a persistent disk path, e.g. /var/data
DATA_DIR=./.data
# First day of the labelled simulated clock (date-only ISO). Demo reset returns here.
SIM_START_DATE=2026-11-16
# Set to 1 to force every external integration into mock mode (e2e, offline takes).
FORCE_MOCKS=0

# ---- PayPal (sandbox only) ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the sandbox app's webhook registration (Render URL + /api/paypal/webhook)
PAYPAL_WEBHOOK_ID=
# Same value as PAYPAL_CLIENT_ID; exposed to the browser for the JS SDK
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# buyer-country only works in sandbox; ES makes the Spanish Pay Later offer render
NEXT_PUBLIC_PAYPAL_BUYER_COUNTRY=ES
# CAPTURE (default) or AUTHORIZE (only if docs/spikes/paylater-es.md says Pay Later renders under AUTHORIZE)
PHASE_PAYMENT_INTENT=CAPTURE
# Sandbox personal (buyer) account email of the synthetic patient; the agent guard only invoices this recipient
DEMO_PATIENT_EMAIL=
# Sandbox business (merchant) account email, used as invoicer on invoices
DEMO_MERCHANT_EMAIL=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_EXTRACT=claude-sonnet-5-5
ANTHROPIC_MODEL_WORDING=claude-sonnet-5-5
ANTHROPIC_MODEL_AGENT=claude-sonnet-5-5
ANTHROPIC_MODEL_CHAT=claude-haiku-5-5
# auto = LLM tool loop when ANTHROPIC_API_KEY is set, deterministic playbook otherwise; llm | playbook to force
AGENT_MODE=auto

# ---- Build only (fallback, normally unused) ----
# Only needed if the public npm trial alias fails and .npmrc is switched to npm.bryntum.com
BRYNTUM_NPM_TOKEN=
