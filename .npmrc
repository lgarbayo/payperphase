# Bryntum is installed from the PUBLIC npm trial alias ("@bryntum/gantt": "npm:@bryntum/gantt-trial@7.3.8"),
# so no registry secret is needed. Fallback only if the alias ever breaks (see docs/spikes/bryntum-render.md):
# @bryntum:registry=https://npm.bryntum.com
# //npm.bryntum.com/:_authToken=${BRYNTUM_NPM_TOKEN}
engine-strict=false
save-exact=true
