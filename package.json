{
  "name": "payperphase",
  "version": "0.1.0",
  "private": true,
  "description": "Pay for multi-visit dental treatment one clinical phase at a time, with PayPal, as each phase is delivered.",
  "license": "MIT",
  "author": "Luis Garbayo Fernández",
  "repository": {
    "type": "git",
    "url": "https://github.com/lgarbayo/payperphase.git"
  },
  "homepage": "https://payperphase.onrender.com",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "e2e": "playwright test",
    "pdfs": "tsx scripts/pdfs/generate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "@bryntum/gantt": "npm:@bryntum/gantt-trial@7.3.8",
    "@bryntum/gantt-react": "7.3.8",
    "@paypal/agent-toolkit": "1.11.0",
    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "next": "15.5.29",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "fast-check": "4.10.2",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
